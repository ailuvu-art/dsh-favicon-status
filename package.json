{
  "name": "dsh-favicon-status",
  "version": "0.2.0",
  "description": "Mirrors DeepSeek Harness Session status onto the browser tab: favicon badge (red broken, yellow waiting, green done, spinner running) and a title prefix.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "index.js",
    "locale/*.json"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test tests/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuvu-art/dsh-favicon-status.git"
  },
  "homepage": "https://github.com/ailuvu-art/dsh-favicon-status#readme",
  "bugs": {
    "url": "https://github.com/ailuvu-art/dsh-favicon-status/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "favicon",
    "tab-status"
  ]
}
