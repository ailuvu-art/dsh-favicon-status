{
  "name": "dsh-favicon-status",
  "version": "0.2.0",
  "description": "Mirrors DeepSeek Harness Session status onto the browser tab: favicon badge (red broken, yellow waiting, green done, spinner running) and a title prefix.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test tests/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
